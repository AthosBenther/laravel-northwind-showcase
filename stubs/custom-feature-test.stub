<?php

use App\Models\{{ modelName }};
use function Pest\Laravel\{delete, get, post};
use function Pest\Laravel\{put};

$testingId = null;

describe('{{ modelName }}', function () use (&$testingId) {
    test('can index', function () {
        $response = get('api/{{ routeName }}');

        $response->assertStatus(200);
    });

    test('can create', function () use (&$testingId) {
        $testPayload = {{ createTestPayload }};

        $response = post('api/{{ routeName }}', $testPayload, [
            'Accept' => 'application/json',
        ]);

        $response->assertStatus(201);

        $responseData = $response->json();

        expect(normalize_dates($responseData))->toMatchArray(normalize_dates($testPayload));
        $testingId = $responseData['{{ modelName }}'.'ID'];
    });

    test('can read', function () use (&$testingId)  {
        $response = get("api/{{ routeName }}/$testingId");

        $response->assertStatus(200);
        $responseData = $response->json();
        expect($responseData)->not()->toBe([]);
    });

    test('can update', function () use (&$testingId){
        $testPayload = {{ updateTestPayload }};

        $response = put("api/{{ routeName }}/$testingId", $testPayload, [
            'Accept' => 'application/json',
        ]);

        $response->assertStatus(200);

        $responseData = $response->json();

        expect(normalize_dates($responseData))->toMatchArray(normalize_dates($testPayload));
    });

    test('can delete', function () use (&$testingId) {
        $id = {{ testPK }};

        $response = delete("api/{{ routeName }}/$testingId", [
            'Accept' => 'application/json',
        ]);

        $response->assertStatus(204);
    });
});
